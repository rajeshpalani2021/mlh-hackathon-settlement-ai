# Copy to backend/.env and fill in. Never commit .env.
# Tiger Data (TimescaleDB) - SSL required
DB_URL=jdbc:postgresql://<host>:<port>/tsdb?sslmode=require
DB_USER=tsdbadmin
DB_PASSWORD=changeme
# Optional read-only role for the agent's SQL tool (created at startup if permissions allow)
DB_READONLY_USER=settle_ro
DB_READONLY_PASSWORD=changeme
# NVIDIA OpenAI-compatible API: POST https://integrate.api.nvidia.com/v1/chat/completions
NVIDIA_API_KEY=nvapi-changeme
NVIDIA_MODEL=google/gemma-4-31b-it
# Optional overrides (defaults shown)
# NVIDIA_BASE_URL=https://integrate.api.nvidia.com
# NVIDIA_ENABLE_THINKING=false
# Optional
SENTRY_DSN=
